BANK_ALFALAH_CHANNEL_ID="1001"
BANK_ALFALAH_IS_REDIRECTION_REQUEST="0"
BANK_ALFALAH_RETURN_URL="https://your-domain.example/payments/alfalah/return"
BANK_ALFALAH_MERCHANT_ID=
BANK_ALFALAH_STORE_ID=
